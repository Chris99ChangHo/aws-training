{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "semgrep",
          "semanticVersion": "1.0.0",
          "rules": [
            {
              "id": "python.lang.security.audit.dangerous-subprocess-use",
              "name": "dangerous-subprocess-use",
              "shortDescription": { "text": "Detected subprocess with shell=True" },
              "defaultConfiguration": { "level": "error" },
              "properties": {
                "security-severity": "9.5",
                "tags": ["CWE-78", "OWASP-A03:2021"]
              }
            },
            {
              "id": "python.django.security.audit.xss.template-autoescape-off",
              "name": "template-autoescape-off",
              "shortDescription": { "text": "Autoescape disabled" },
              "defaultConfiguration": { "level": "warning" },
              "properties": {
                "security-severity": "6.1",
                "tags": ["CWE-79"]
              }
            },
            {
              "id": "generic.secrets.hardcoded-token",
              "name": "hardcoded-token",
              "shortDescription": { "text": "Hardcoded credential" },
              "defaultConfiguration": { "level": "error" },
              "properties": { "tags": ["CWE-798"] }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "python.lang.security.audit.dangerous-subprocess-use",
          "level": "error",
          "message": { "text": "subprocess call with shell=True identified" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "app/tasks.py" },
                "region": { "startLine": 42, "startColumn": 5 }
              }
            }
          ]
        },
        {
          "ruleId": "python.django.security.audit.xss.template-autoescape-off",
          "level": "warning",
          "message": { "text": "autoescape is off in this template block" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "web/templates/profile.html" },
                "region": { "startLine": 17 }
              }
            }
          ]
        },
        {
          "ruleId": "generic.secrets.hardcoded-token",
          "level": "error",
          "message": { "text": "hardcoded token assigned to API_KEY" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "config/settings.py" },
                "region": { "startLine": 9 }
              }
            }
          ]
        }
      ]
    }
  ]
}
